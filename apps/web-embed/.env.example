# Base URL of the AgentStudio API server.
# The embed app uses this to reach the public chat endpoints.
VITE_API_URL=https://connect.localhost:3000
# The origin that serves the sandbox of MCP App cards, apart from the widget's own. {label} stands
# for a label of the card's MCP server. Unset, the widget writes the sandbox itself.
#VITE_MCP_APP_SANDBOX_ORIGIN=https://{label}.usercontent.example.org
