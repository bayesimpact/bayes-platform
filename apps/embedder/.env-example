# Copy to .env, then `npm run dev` at the repository root starts the service (once .venv exists).

# Models loaded at startup and served. Downloaded from the HuggingFace hub on first start.
EMBEDDER_MODELS=BAAI/bge-m3

# cuda | mps | cpu, auto-detected when unset. Apple Silicon picks mps.
# EMBEDDER_DEVICE=mps

# Requests must send `Authorization: Bearer <key>` when set. Leave empty on a laptop.
# EMBEDDER_API_KEY=

# Must match EMBEDDER_BGE_M3_URL in apps/api/.env (default http://localhost:3003).
PORT=3003
