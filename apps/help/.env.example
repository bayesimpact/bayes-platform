# URL of the main application, shown as a "Back to the app" link in the header.
# Optional — the link is hidden when unset.
PUBLIC_APP_URL=https://app.bayesimpact.org

# Base URL of this tenant's API, shown on the public API reference page. Optional — a
# placeholder is shown when unset. The deploy job sets the real value per tenant.
PUBLIC_API_BASE_URL=https://api.example.com

# Public URL of this help site (canonical links, sitemap). Optional — falls back to
# SITE_URL in src/consts.ts. The deploy job sets the real value per tenant.
PUBLIC_SITE_URL=https://help.example.com
