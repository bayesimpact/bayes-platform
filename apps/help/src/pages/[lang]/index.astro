---
import type { GetStaticPaths } from "astro"
import DocCards from "@/components/DocCards.astro"
import Search from "@/components/Search.astro"
import SectionHead from "@/components/SectionHead.astro"
import { isLocale, type Locale, LOCALES } from "@/consts"
import { categoryLabel, getCategory } from "@/i18n/categories"
import { useTranslations } from "@/i18n/ui"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { getDocsForLocale, groupByCategory } from "@/lib/docs"
import { highlightKeyword } from "@/lib/highlight"

export const getStaticPaths = (() => {
  return LOCALES.map((lang) => ({ params: { lang } }))
}) satisfies GetStaticPaths

const { lang } = Astro.params
const locale: Locale = isLocale(lang) ? lang : "en"
const t = useTranslations(locale)

const docs = await getDocsForLocale(locale)
const groups = groupByCategory(docs)
const description = (id: string) => getCategory(id)?.description[locale]
---

{/* The site's one-pager layout (/platform, /sectors): the hero's head, then one white band per
    category, each opening on a section head (the category's name as the pill, its description as
    the title) over a grid of guide cards. A parent category lists its sub-categories under it. */}
<BaseLayout title={t("site.title")} locale={locale} headerSearch={false}>
  <div class="dp">
    <div class="gp-hero dp-hero">
      <div class="gp-wrap gp-hero-in">
        <SectionHead as="h1" title={highlightKeyword(t("home.heading"), t("home.highlight"))} lead={t("site.tagline")}>
          <div class="hc-hero-search"><Search /></div>
          <nav class="dp-index" aria-label={t("home.categories")}>
            {groups.map((group) => <a href={`#${group.id}`}>{categoryLabel(group.id, locale)}</a>)}
          </nav>
        </SectionHead>
      </div>
    </div>

    {
      groups.map((group) => (
        <section class="band b-paper" id={group.id}>
          <div class="gp-wrap">
            <SectionHead pill={categoryLabel(group.id, locale)} title={description(group.id) ?? ""} />
            {group.docs.length > 0 && <DocCards docs={group.docs} />}
            {group.children.map((child) => (
              <div class="hc-sub" id={child.id}>
                <h3 class="dp-sub">{categoryLabel(child.id, locale)}</h3>
                {description(child.id) && <p class="dp-sub-lead">{description(child.id)}</p>}
                <DocCards docs={child.docs} />
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .hc-hero-search {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 8px;
  }
  /* A sub-category right under its parent's head needs no section-sized gap above it. */
  .dp-head + .hc-sub .dp-sub {
    margin-top: 0;
  }
  .hc-sub .dp-sub-lead {
    margin-bottom: 4px;
  }
</style>
