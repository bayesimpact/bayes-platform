---
import SectionHead from "@/components/SectionHead.astro"
import { DEFAULT_LOCALE } from "@/consts"
import { useTranslations } from "@/i18n/ui"
import { localizedPath } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"

const locale = DEFAULT_LOCALE
const t = useTranslations(locale)
---

<BaseLayout title={t("notFound.title")} locale={locale}>
  <div class="dp">
    <div class="gp-hero dp-hero">
      <div class="gp-wrap gp-hero-in">
        <SectionHead as="h1" title={t("notFound.title")} lead={t("notFound.body")}>
          <div class="dp-actions">
            <a class="btn btn-primary" href={localizedPath(locale)}>{t("notFound.cta")}</a>
          </div>
        </SectionHead>
      </div>
    </div>
  </div>
</BaseLayout>
