const s = STRINGS[lang]


const convIcon = '<path d="M12 6V2H8"/><path d="m8 18-4 4V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2Z"/><path d="M9 11v2"/><path d="M15 11v2"/>'
const formIcon = '<path d="M4 14h6"/><path d="M4 2h10"/><rect x="4" y="18" width="16" height="4" rx="1"/><rect x="4" y="6" width="16" height="4" rx="1"/>'

const steps = [
  { page: "overview", sec: "", spot: "navAgent1", observe: [] },
  { page: "agentPage", sec: "", spot: "btnEdit", observe: [] },
  { page: "editorGeneral", sec: "general", spot: "sec-orchestration", observe: [] },
  { page: "sheetEmpty", sec: "general", spot: "", observe: ["obsEmpty"] },
  { page: "sheetEmpty", sec: "general", spot: "btnAdd", observe: [] },
  { page: "sheetFilled", sec: "general", spot: "", observe: ["obsFields"] },
  { page: "sheetFilled", sec: "general", spot: "", observe: ["obsRow"] },
  { page: "sheetFilled", sec: "general", spot: "btnSave", observe: [] },
  { page: "confirmSave", under: "sheetFilled", sec: "general", spot: "btnConfirmSave", observe: ["obsConfirmSave"] },
].map((step, i) => ({ ...step, text: s.steps[i] }))

const titles = { general: s.secGeneral }
const labels = { prev: s.prev, next: s.next, step: s.step }
---

<div class="orw" role="group" aria-label={s.tabOrchestration}>
  <div class="shell">
    <!-- Sidebar -->
    <aside class="sb">
      <div class="sb-head">
        <span class="logo"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 410.85 405.35" aria-hidden="true"><path d="M366.77,161.43H247V41.61a41.37,41.37,0,1,0-82.74,0V161.43H44.39a41.37,41.37,0,0,0,0,82.74H164.21V364A41.37,41.37,0,1,0,247,364V244.17H366.77a41.37,41.37,0,1,0,0-82.74Z"/><circle cx="205.58" cy="364.27" r="41.05"/><circle cx="369.79" cy="202.64" r="41.05"/><circle cx="41.05" cy="202.64" r="41.05"/><circle cx="205.58" cy="41.05" r="41.05"/><circle cx="205.58" cy="202.64" r="41.05"/></svg></span>
        <span class="org"><b>{s.org}</b><small>{s.studio}</small></span>
      </div>
      <div class="sb-scroll">
        <div class="grp-label">{s.agents}<span class="add"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg></span></div>
        <div class="navitem" id="navAgent1"><svg viewBox="0 0 24 24" set:html={convIcon}></svg><span>{s.agentName}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24" set:html={convIcon}></svg><span>{s.subA}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24" set:html={formIcon}></svg><span>{s.subB}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M7 8h8"/><path d="M7 12h10"/><path d="M7 16h6"/></svg><span>{s.extractionAgent}</span></div>

        <div class="grp-label stack"><span class="name">{s.settingsName}</span><span>{s.settings}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg><span>{s.evaluations}</span><svg class="chev" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg><span>{s.analytics}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 15 21.84"/><path d="M21 5V8"/><path d="M21 12L18 17H22L19 22"/><path d="M3 12A9 3 0 0 0 14.59 14.87"/></svg><span>{s.sources}</span><svg class="chev" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg><span>{s.members}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg><span>{s.admin}</span></div>
      </div>
      <div class="sb-user">
        <span class="avatar">AM</span>
        <span class="who"><b>{s.userName}</b><small>{s.userEmail}</small></span>
        <span class="updown"><svg viewBox="0 0 24 24"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg></span>
      </div>
    </aside>

    <!-- The agent editor's own menu, in place of the Studio sidebar -->
    <aside class="esb">
      <span class="ebk"><svg viewBox="0 0 24 24"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> {s.back}</span>
      <div class="agent-id"><b><svg viewBox="0 0 24 24"><path d="M12 6V2H8"/><path d="m8 18-4 4V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2Z"/><path d="M9 11v2"/><path d="M15 11v2"/></svg><span>{s.agentName}</span></b><small>{s.editTitleShort}</small></div>
      <div class="esb-list">
        <div class="navitem" data-sec="general" id="sec-general"><svg viewBox="0 0 24 24"><path d="M10 5H3"/><path d="M12 19H3"/><path d="M14 3v4"/><path d="M16 17v4"/><path d="M21 12h-9"/><path d="M21 19h-5"/><path d="M21 5h-7"/><path d="M8 10v4"/><path d="M8 12H3"/></svg><span>{s.secGeneral}</span></div>
        <div class="navitem" data-sec="model" id="sec-model"><svg viewBox="0 0 24 24"><path d="M12 20v2"/><path d="M12 2v2"/><path d="M17 20v2"/><path d="M17 2v2"/><path d="M2 12h2"/><path d="M2 17h2"/><path d="M2 7h2"/><path d="M20 12h2"/><path d="M20 17h2"/><path d="M20 7h2"/><path d="M7 20v2"/><path d="M7 2v2"/><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="8" y="8" width="8" height="8" rx="1"/></svg><span>{s.secModel}</span></div>
        <div class="navitem" data-sec="sources" id="sec-sources"><svg viewBox="0 0 24 24"><rect width="8" height="18" x="3" y="3" rx="1"/><path d="M7 3v18"/><path d="M20.4 18.9c.2.5-.1 1.1-.6 1.3l-1.9.7c-.5.2-1.1-.1-1.3-.6L11.1 5.1c-.2-.5.1-1.1.6-1.3l1.9-.7c.5-.2 1.1.1 1.3.6Z"/></svg><span>{s.secSources}</span></div>
        <div class="navitem" data-sec="tools" id="sec-tools"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></svg><span>{s.secTools}</span></div>
        <div class="navitem" data-sec="categories" id="sec-categories"><svg viewBox="0 0 24 24"><path d="M13.172 2a2 2 0 0 1 1.414.586l6.71 6.71a2.4 2.4 0 0 1 0 3.408l-4.592 4.592a2.4 2.4 0 0 1-3.408 0l-6.71-6.71A2 2 0 0 1 6 9.172V3a1 1 0 0 1 1-1z"/><path d="M2 7v6.172a2 2 0 0 0 .586 1.414l6.71 6.71a2.4 2.4 0 0 0 3.191.193"/><circle cx="10.5" cy="6.5" r=".5" fill="currentColor"/></svg><span>{s.secCategories}</span></div>
        <div class="grp-more">{s.more}</div>
        <div class="navitem" data-sec="mcpServers" id="sec-mcpServers"><svg viewBox="0 0 24 24"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg><span>{s.secMcpServers}</span></div>
        <div class="navitem" id="sec-orchestration"><svg viewBox="0 0 24 24"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg><span>{s.secOrchestration}</span><svg class="ext" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></div>
        <div class="navitem" id="sec-embed"><svg viewBox="0 0 24 24"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg><span>{s.secEmbed}</span><svg class="ext" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></div>
      </div>
      <div class="esb-foot"><span class="btn wide" id="btnManage"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg> {s.manage}</span></div>
    </aside>

    <!-- Main inset -->
    <div class="inset">
      <div class="topbar">
        <span class="trig"><svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg></span>
        <span class="etop"><span class="sec" data-sectitle></span><span class="status" id="obsStatus"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg> {s.draftSaved}</span></span>
      </div>
      <div class="canvas">
        <span class="fab"><svg viewBox="0 0 24 24"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg></span>

        <!-- workspace overview (step 1) -->
        <div class="page" data-page="overview" data-active="true">
          <div class="page-head plain">
            <span><span class="ttl">{s.settingsName}</span><span class="desc">{s.studio}</span></span>
          </div>
          <div class="cards3">
            <div class="ecard"><span class="cat">{s.conversation}</span><b class="ic"><svg viewBox="0 0 24 24" set:html={convIcon}></svg> {s.agentName}</b><span class="arrowbtn"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
            <div class="ecard"><span class="cat">{s.conversation}</span><b class="ic"><svg viewBox="0 0 24 24" set:html={convIcon}></svg> {s.subA}</b><span class="arrowbtn"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
            <div class="ecard"><span class="cat">Form</span><b class="ic"><svg viewBox="0 0 24 24" set:html={formIcon}></svg> {s.subB}</b><span class="arrowbtn"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
          </div>
        </div>

        <!-- the agent's page: Edit with its version, the More menu, then the cards -->
        <div class="page" data-page="agentPage">
          <div class="page-head ap-head">
            <span class="backbtn"><svg viewBox="0 0 24 24"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg></span>
            <span><span class="ttl">{s.agentName}</span><span class="desc ic"><span>{s.agentType}</span> <svg viewBox="0 0 24 24"><path d="M12 6V2H8"/><path d="m8 18-4 4V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2Z"/><path d="M9 11v2"/><path d="M15 11v2"/></svg></span></span>
            <span class="ap-acts"><span class="btn outline" id="btnEdit"><svg viewBox="0 0 24 24"><path d="M14 17H5"/><path d="M19 7h-9"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg> {s.edit} <span class="vbadge">{s.verBadge}</span></span><span class="btn outline icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg></span></span>
          </div>
          <div class="cards3">
            <div class="ecard muted"><b>{s.newChat}</b><p>{s.newChatDesc}</p><span class="btn sm">{s.newChat} <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg></span></div>
            <div class="ecard"><b>{s.feedback}</b><p>{s.feedbackDesc}</p><span class="gobtn"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
            <div class="ecard"><b>{s.goToApp} <span class="vbadge">{s.production}</span></b><p>{s.appDesc}</p><span class="gobtn"><svg viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></span></div>
            <div class="ecard"><b>{s.goToEval}</b><p>{s.evalDesc}</p><span class="gobtn"><svg viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></span></div>
            <div class="ecard"><b>{s.membersCard}</b><p>{s.membersCardDesc}</p><span class="gobtn" id="btnMembersCard"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
          </div>
        </div>

        <!-- the agent editor, open on General -->
        <div class="page" data-page="editorGeneral">
          <div class="eform">
            <div class="grid2"><div class="fld"><p class="lbl">{s.nameLabel}</p><span class="input block">{s.agentName}</span></div></div>
            <div class="fld"><p class="lbl">{s.greetingLabel}<span class="count">{s.greetingCount}</span></p><span class="textarea mono">{s.greetingValue}</span></div>
            <div class="fld"><p class="lbl">{s.instructionsLabel}<span class="count">{s.instructionsCount}</span></p><span class="textarea mono grow">{s.instructionsValue}</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Orchestration, empty (steps 4 and 5): a full-page sheet outside the draft, with Cancel and Save -->
    <div class="page full" data-page="sheetEmpty">
      <div class="esheet">
        <div class="es-head">
          <span><b>{s.tabOrchestration}</b><p>{s.liveNotice}</p></span>
          <span class="es-acts"><span class="btn outline">{s.close}</span><span class="btn disabled" id="btnSaveIdle">{s.save}</span></span>
          <span class="closex"><svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span>
        </div>
        <div class="es-body">
          <div class="es-inner">
              <p class="lbl" style="margin-top:0">{s.selectedTitle}</p>
              <div class="empty" id="obsEmpty">
                <span class="empty-ic"><svg viewBox="0 0 24 24"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg></span>
