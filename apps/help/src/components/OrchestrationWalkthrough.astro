                  <span class="ac-media"><svg viewBox="0 0 24 24" set:html={convIcon}></svg></span>
                  <span class="ac-body"><b>{s.subA}</b><small>{s.subAInstr}</small></span>
                  <span class="btn outline sm" id="btnAdd"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg> {s.add}</span>
                </div>
                <div class="acard">
                  <span class="ac-media"><svg viewBox="0 0 24 24" set:html={formIcon}></svg></span>
                  <span class="ac-body"><b>{s.subB}</b><small>{s.subBInstr}</small></span>
                  <span class="btn outline sm"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg> {s.add}</span>
                </div>
              </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Orchestration, one sub-agent (steps 6 to 9): a full-page sheet outside the draft, with Cancel and Save -->
    <div class="page full" data-page="sheetFilled">
      <div class="esheet">
        <div class="es-head">
          <span><b>{s.tabOrchestration}</b><p>{s.liveNotice}</p></span>
          <span class="es-acts"><span class="btn outline">{s.cancel}</span><span class="btn" id="btnSave">{s.save}</span></span>
          <span class="closex"><svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span>
        </div>
        <div class="es-body">
          <div class="es-inner">
              <p class="lbl" style="margin-top:0">{s.selectedTitle}</p>
              <div class="sa-card">
                <div class="sa-head" id="obsRow">
                  <span class="sa-media"><svg viewBox="0 0 24 24" set:html={convIcon}></svg></span>
