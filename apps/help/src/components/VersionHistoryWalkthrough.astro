---
/**
 * Walkthrough of the agent settings Version history. Derived from the real
 * components (verified, not copied blind): AgentEditorPageView.tsx (the editor as a
 * page of its own: Back, agent name, draft sections, the "More" group, the
 * "Manage versions" button at the bottom of the menu, the save status in the header),
 * AgentEditorSaveStatus.tsx (Draft saved opens the history), AgentSettingsHistorySheet.tsx
 * (full-screen sheet), AgentSettingsList.tsx (rows, Draft and Current badges),
 * AgentSettingsExplorer.tsx (default selection and comparison), AgentSettingsCompare.tsx
 * (Save version or Restore, the three comparisons, the changed fields line, the diffs),
 * AgentSettingsCreateButton.tsx (Save version dialog) and AgentSettingsRestoreButton.tsx
 * (restore confirmation). Labels verbatim from the agentSettings / agent / actions / status
 * locales (EN + FR). Uses the PRODUCT (coral) palette, pinned locally.
 * Derived 2026-07-16, rebuilt for the editor page and its automatic save 2026-11-16.
 */
type Lang = "en" | "fr"
const { lang = "en" } = Astro.props as { lang?: Lang }

const STRINGS = {
  en: {
    back: "Back", agentName: "Helpful Assistant", editTitle: "Edit Conversation Agent",
    secGeneral: "General", secModel: "Model", secSources: "Sources", secTools: "Tools",
    more: "More", secMcp: "MCP Servers", secOrchestration: "Orchestration", secEmbed: "Embed",
    manage: "Manage versions",
    draftSaved: "Draft saved",
    nameLabel: "Name", greetingLabel: "Greeting", greetingCount: "29 / 2,000 characters",
    greetingValue: "Hi! How can I help you today?",
    instructionsLabel: "Instructions", instructionsCount: "63 characters", advancedMode: "Advanced mode",
    instructionsValue: "You are a helpful assistant. Answer concisely and cite sources.",
    panelTitle: "Version history",
    panelDesc: "Browse, compare and restore previous settings of Helpful Assistant.",
    vLabel3: "Version 3", vLabel2: "Version 2", vLabel1: "Version 1",
    t3: "just now", t2: "2 days ago", t1: "last week",
    draft: "Draft", current: "Current",
    v2Name: "Shorter answers",
    cmpPrev: "Changes in this version", cmpCur: "Compare with current", cmpDraft: "Compare with draft",
    comparing32: "Showing changes from version 2 to version 3.",
    comparing13: "Showing changes from version 1 to version 3.",
    changed2: "2 changed fields:", changed1: "1 changed field:",
    fInstructions: "Instructions", fGreeting: "Greeting",
    diffInsDel: "You are a helpful assistant.",
    diffInsAdd: "You are a helpful assistant. Answer concisely and cite sources.",
    diffGreetDel: "Hello!",
    diffGreetAdd: "Hi! How can I help you today?",
    diffInsDel1: "You are an assistant.",
    saveVersion: "Save version",
    saveTitle: "Save version 3?",
    saveDesc: "Version 3 becomes the settings this agent runs with. Later changes start a new draft version.",
    versionName: "Version name", versionNamePh: "Name this version",
    versionDesc: "Version description", versionDescPh: "Describe what changed in this version",
    optional: "Optional",
    restore: "Restore this version", cancel: "Cancel",
    confirmTitle: "Restore version 1?",
    confirmDesc: "The settings of version 1 will be copied as a new version and become the current settings. No version is deleted.",
    prev: "Prev", next: "Next", step: "Step",
    steps: [
      "In the agent editor, click Manage versions at the bottom of the menu, or the Draft saved status at the top right.",
      "Version history opens full screen. It lists every version, newest first: the Draft, the Current version, then the older ones.",
      "Choose what the selected version is compared with: Changes in this version, Compare with current or Compare with draft.",
      "The line of changed fields jumps to each diff. Removed text is red, added text is green.",
      "With the draft selected, click Save version.",
      "Name and describe the version if you wish, then click Save version. The agent now runs with it.",
      "To go back to an older version, select it and click Restore this version.",
      "Confirm. Its settings are copied as a new version, which becomes the current one. No version is deleted.",
    ],
  },
  fr: {
    back: "Retour", agentName: "Helpful Assistant", editTitle: "Modifier l'agent conversationnel",
    secGeneral: "Général", secModel: "Modèle", secSources: "Sources", secTools: "Outils",
    more: "Plus", secMcp: "Serveurs MCP", secOrchestration: "Orchestration", secEmbed: "Intégration",
    manage: "Gérer les versions",
    draftSaved: "Brouillon enregistré",
    nameLabel: "Nom", greetingLabel: "Message d'accueil", greetingCount: "50 / 2 000 caractères",
    greetingValue: "Bonjour ! Comment puis-je vous aider aujourd’hui ?",
    instructionsLabel: "Instructions", instructionsCount: "77 caractères", advancedMode: "Mode avancé",
    instructionsValue: "Vous êtes un assistant utile. Répondez de façon concise et citez vos sources.",
    panelTitle: "Historique des versions",
    panelDesc: "Parcourez, comparez et restaurez les paramètres précédents de Helpful Assistant.",
    vLabel3: "Version 3", vLabel2: "Version 2", vLabel1: "Version 1",
    t3: "à l'instant", t2: "il y a 2 jours", t1: "la semaine dernière",
    draft: "Brouillon", current: "Actuelle",
    v2Name: "Réponses plus courtes",
    cmpPrev: "Changements de cette version", cmpCur: "Comparer avec l'actuelle", cmpDraft: "Comparer avec le brouillon",
    comparing32: "Changements de la version 2 à la version 3.",
    comparing13: "Changements de la version 1 à la version 3.",
    changed2: "2 champs modifiés :", changed1: "1 champ modifié :",
    fInstructions: "Instructions", fGreeting: "Message d'accueil",
    diffInsDel: "Vous êtes un assistant utile.",
    diffInsAdd: "Vous êtes un assistant utile. Répondez de façon concise et citez vos sources.",
    diffGreetDel: "Bonjour !",
    diffGreetAdd: "Bonjour ! Comment puis-je vous aider aujourd’hui ?",
    diffInsDel1: "Vous êtes un assistant.",
    saveVersion: "Enregistrer la version",
    saveTitle: "Enregistrer la version 3 ?",
    saveDesc: "La version 3 devient les paramètres utilisés par cet agent. Les modifications suivantes créeront une nouvelle version brouillon.",
    versionName: "Nom de la version", versionNamePh: "Nommez cette version",
    versionDesc: "Description de la version", versionDescPh: "Décrivez ce qui a changé dans cette version",
    optional: "Facultatif",
    restore: "Restaurer cette version", cancel: "Annuler",
    confirmTitle: "Restaurer la version 1 ?",
    confirmDesc: "Les paramètres de la version 1 seront copiés comme nouvelle version et deviendront les paramètres actuels. Aucune version n'est supprimée.",
    prev: "Précédent", next: "Suivant", step: "Étape",
    steps: [
      "Dans l'éditeur de l'agent, cliquez sur Gérer les versions en bas du menu, ou sur le statut Brouillon enregistré en haut à droite.",
      "L'historique des versions s'ouvre en plein écran. Il liste chaque version, la plus récente en premier : le Brouillon, la version Actuelle, puis les plus anciennes.",
      "Choisissez avec quoi comparer la version sélectionnée : Changements de cette version, Comparer avec l'actuelle ou Comparer avec le brouillon.",
      "La ligne des champs modifiés mène à chaque différence. Le texte retiré est en rouge, le texte ajouté en vert.",
      "Le brouillon sélectionné, cliquez sur Enregistrer la version.",
      "Nommez et décrivez la version si vous le voulez, puis cliquez sur Enregistrer la version. L'agent l'utilise désormais.",
      "Pour revenir à une version plus ancienne, sélectionnez-la et cliquez sur Restaurer cette version.",
      "Confirmez. Ses paramètres sont copiés dans une nouvelle version, qui devient l'actuelle. Aucune version n'est supprimée.",
    ],
  },
} as const

const s = STRINGS[lang]

// `under` keeps the history page visible below a dialog.
const steps = [
  { page: "editor", spot: "btnManage", observe: ["obsStatus"] },
  { page: "historyDraft", spot: "", observe: ["obsList"] },
  { page: "historyDraft", spot: "", observe: ["obsToggle"] },
  { page: "historyDraft", spot: "", observe: ["obsDiff"] },
  { page: "historyDraft", spot: "btnSaveVersion", observe: [] },
  { page: "saveDialog", under: "historyDraft", spot: "btnSaveConfirm", observe: ["obsSaveFields"] },
  { page: "historyV1", spot: "btnRestore", observe: ["obsRowV1"] },
  { page: "restoreDialog", under: "historyV1", spot: "", observe: ["obsConfirm"] },
].map((step, i) => ({ ...step, text: s.steps[i] }))

const labels = { prev: s.prev, next: s.next, step: s.step }
---

<div class="vhw" role="group" aria-label={s.panelTitle}>
  <div class="shell">
    <!-- The editor's own menu: the editor is a page of its own, outside the Studio layout -->
    <aside class="sb">
      <span class="backbtn"><svg viewBox="0 0 24 24"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> {s.back}</span>
      <div class="agent-id">
        <b><svg viewBox="0 0 24 24"><path d="M12 6V2H8"/><path d="m8 18-4 4V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2Z"/><path d="M9 11v2"/><path d="M15 11v2"/></svg><span>{s.agentName}</span></b>
        <small>{s.editTitle}</small>
      </div>
      <div class="sb-scroll">
        <div class="navitem on"><svg viewBox="0 0 24 24"><path d="M10 5H3"/><path d="M12 19H3"/><path d="M14 3v4"/><path d="M16 17v4"/><path d="M21 12h-9"/><path d="M21 19h-5"/><path d="M21 5h-7"/><path d="M8 10v4"/><path d="M8 12H3"/></svg><span>{s.secGeneral}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M12 20v2"/><path d="M12 2v2"/><path d="M17 20v2"/><path d="M17 2v2"/><path d="M2 12h2"/><path d="M2 17h2"/><path d="M2 7h2"/><path d="M20 12h2"/><path d="M20 17h2"/><path d="M20 7h2"/><path d="M7 20v2"/><path d="M7 2v2"/><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="8" y="8" width="8" height="8" rx="1"/></svg><span>{s.secModel}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><rect width="8" height="18" x="3" y="3" rx="1"/><path d="M7 3v18"/><path d="M20.4 18.9c.2.5-.1 1.1-.6 1.3l-1.9.7c-.5.2-1.1-.1-1.3-.6L11.1 5.1c-.2-.5.1-1.1.6-1.3l1.9-.7c.5-.2 1.1.1 1.3.6Z"/></svg><span>{s.secSources}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></svg><span>{s.secTools}</span></div>

        <div class="grp-label">{s.more}</div>
        <div class="navitem"><svg viewBox="0 0 24 24"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg><span>{s.secMcp}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg><span>{s.secOrchestration}</span><svg class="chev" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg><span>{s.secEmbed}</span><svg class="chev" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></div>
      </div>
      <div class="sb-foot">
        <span class="btn wide" id="btnManage"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg> {s.manage}</span>
      </div>
    </aside>

    <!-- The active section, under its header with the save status -->
    <div class="inset">
      <div class="topbar">
        <span class="ttl">{s.secGeneral}</span>
        <span class="status draft" id="obsStatus"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg> {s.draftSaved}</span>
      </div>
      <div class="canvas">
        <div class="page" data-page="editor" data-active="true">
          <div class="form">
            <div class="grid2">
              <div class="fld"><p class="lbl">{s.nameLabel}</p><span class="input block">{s.agentName}</span></div>
            </div>
            <div class="fld"><p class="lbl">{s.greetingLabel} <span class="count">{s.greetingCount}</span></p><span class="textarea mono">{s.greetingValue}</span></div>
            <div class="fld">
              <div class="lbl-row"><p class="lbl">{s.instructionsLabel} <span class="count">{s.instructionsCount}</span></p><span class="btn outline sm"><svg viewBox="0 0 24 24"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg> {s.advancedMode}</span></div>
              <span class="textarea mono tall">{s.instructionsValue}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Version history, full screen, the draft selected (steps 2 to 5) -->
    <div class="page full" data-page="historyDraft">
      <div class="sheet">
        <div class="sheet-head"><span><b>{s.panelTitle}</b><p>{s.panelDesc}</p></span><span class="closex"><svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span></div>
        <div class="sheet-body">
          <div class="vlist" id="obsList">
            <div class="vrow on"><span class="vr-top"><b>{s.vLabel3}</b><span class="badge warn">{s.draft}</span></span><small>{s.t3}</small></div>
            <div class="vrow"><span class="vr-top"><b>{s.vLabel2}</b><span class="badge ok">{s.current}</span></span><span class="vname">{s.v2Name}</span><small>{s.t2}</small></div>
            <div class="vrow"><span class="vr-top"><b>{s.vLabel1}</b></span><small>{s.t1}</small></div>
          </div>
          <div class="vcompare">
            <div class="vc-head">
              <b>{s.vLabel3} <span class="badge warn">{s.draft}</span></b>
              <span class="btn" id="btnSaveVersion">{s.saveVersion} <svg viewBox="0 0 24 24"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/></svg></span>
            </div>
            <div class="vc-bar" id="obsToggle">
              <span class="toggle"><span class="tg on">{s.cmpPrev}</span><span class="tg off">{s.cmpCur}</span><span class="tg off">{s.cmpDraft}</span></span>
              <p class="cmp-cap">{s.comparing32}</p>
            </div>
            <div class="vc-scroll" id="obsDiff">
              <div class="vc-fields"><span>{s.changed2}</span><span class="chip">{s.fInstructions}</span><span class="chip">{s.fGreeting}</span></div>
              <div class="diffcard">
                <div class="diff-field">{s.fInstructions}</div>
                <div class="diff-line del"><span class="sign">−</span>{s.diffInsDel}</div>
                <div class="diff-line add"><span class="sign">+</span>{s.diffInsAdd}</div>
              </div>
              <div class="diffcard">
                <div class="diff-field">{s.fGreeting}</div>
                <div class="diff-line del"><span class="sign">−</span>{s.diffGreetDel}</div>
                <div class="diff-line add"><span class="sign">+</span>{s.diffGreetAdd}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Save version dialog (step 6) -->
    <div class="page full center" data-page="saveDialog">
      <div class="scrim"></div>
      <div class="modal">
        <div class="m-head"><b>{s.saveTitle}</b><p>{s.saveDesc}</p></div>
        <div class="m-fields" id="obsSaveFields">
          <div class="fld"><p class="lbl">{s.versionName}</p><span class="input block ph">{s.versionNamePh}</span><p class="hint">{s.optional}</p></div>
          <div class="fld"><p class="lbl">{s.versionDesc}</p><span class="textarea ph">{s.versionDescPh}</span><p class="hint">{s.optional}</p></div>
        </div>
        <div class="m-foot"><span class="btn" id="btnSaveConfirm">{s.saveVersion}</span></div>
      </div>
    </div>

    <!-- Version history after the save, version 1 selected (steps 7 and 8) -->
    <div class="page full" data-page="historyV1">
      <div class="sheet">
        <div class="sheet-head"><span><b>{s.panelTitle}</b><p>{s.panelDesc}</p></span><span class="closex"><svg viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span></div>
        <div class="sheet-body">
          <div class="vlist">
            <div class="vrow"><span class="vr-top"><b>{s.vLabel3}</b><span class="badge ok">{s.current}</span></span><small>{s.t3}</small></div>
            <div class="vrow"><span class="vr-top"><b>{s.vLabel2}</b></span><span class="vname">{s.v2Name}</span><small>{s.t2}</small></div>
            <div class="vrow on" id="obsRowV1"><span class="vr-top"><b>{s.vLabel1}</b></span><small>{s.t1}</small></div>
          </div>
          <div class="vcompare">
            <div class="vc-head">
              <b>{s.vLabel1}</b>
              <span class="btn" id="btnRestore"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg> {s.restore}</span>
            </div>
            <div class="vc-bar">
              <span class="toggle"><span class="tg off">{s.cmpPrev}</span><span class="tg on">{s.cmpCur}</span></span>
              <p class="cmp-cap">{s.comparing13}</p>
            </div>
            <div class="vc-scroll">
              <div class="vc-fields"><span>{s.changed2}</span><span class="chip">{s.fInstructions}</span><span class="chip">{s.fGreeting}</span></div>
              <div class="diffcard">
                <div class="diff-field">{s.fInstructions}</div>
                <div class="diff-line del"><span class="sign">−</span>{s.diffInsDel1}</div>
                <div class="diff-line add"><span class="sign">+</span>{s.diffInsAdd}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Restore confirm dialog (step 8) -->
    <div class="page full center" data-page="restoreDialog">
      <div class="scrim"></div>
      <div class="modal" id="obsConfirm">
        <div class="m-head"><b>{s.confirmTitle}</b><p>{s.confirmDesc}</p></div>
        <div class="m-foot"><span class="btn outline">{s.cancel}</span><span class="btn"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg> {s.restore}</span></div>
      </div>
    </div>
  </div>

  <!-- Controls -->
  <div class="controls">
    <button class="navbtn" data-prev><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg> {s.prev}</button>
    <button class="ctrl" data-playpause aria-label="Play / pause">⏸</button>
    <span class="cap"><span class="st" data-stepcount></span><span class="tx" data-captext></span></span>
    <span class="dots-nav" data-dots role="tablist" aria-label="Steps"></span>
    <button class="navbtn primary" data-next>{s.next} <svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></button>
  </div>
  <div class="progress"><i data-bar></i></div>
</div>

<script define:vars={{ steps, labels }}>
  const cs = document.currentScript
  const vhw =
    cs && cs.previousElementSibling && cs.previousElementSibling.classList.contains("vhw")
      ? cs.previousElementSibling
      : document.querySelector(".vhw")
  const q = (sel) => vhw.querySelector(sel)
  const pages = [...vhw.querySelectorAll(".page")]
  const dotsWrap = vhw.querySelector("[data-dots]")
  const bar = vhw.querySelector("[data-bar]")
  const capText = vhw.querySelector("[data-captext]")
  const stepCount = vhw.querySelector("[data-stepcount]")
  const playPause = vhw.querySelector("[data-playpause]")
  const prevBtn = vhw.querySelector("[data-prev]")
  const nextBtn = vhw.querySelector("[data-next]")
  const DUR = 6000
  let idx = 0, playing = true, timer = null

  steps.forEach((_, i) => {
    const b = document.createElement("button")
    b.className = "dotnav"; b.setAttribute("role", "tab"); b.setAttribute("aria-label", labels.step + " " + (i + 1))
    b.addEventListener("click", () => go(i)); dotsWrap.appendChild(b)
  })
  const dots = [...dotsWrap.children]

  function clearMarks() {
    vhw.querySelectorAll(".spot-on").forEach((el) => el.classList.remove("spot-on"))
    vhw.querySelectorAll(".observe-on").forEach((el) => el.classList.remove("observe-on"))
  }
  function render() {
    const step = steps[idx]
    // The editor stays under the full-screen history, and the history under its dialogs.
    pages.forEach((p) => {
      const active = p.dataset.page === step.page || p.dataset.page === "editor" || p.dataset.page === step.under
      p.setAttribute("data-active", String(active))
    })
    dots.forEach((d, i) => d.classList.toggle("on", i === idx))
    stepCount.textContent = labels.step + " " + (idx + 1) + " / " + steps.length
    capText.textContent = step.text

    clearMarks()
    const active = idx
    setTimeout(() => {
      if (active !== idx) return
      if (step.spot) q("#" + step.spot)?.classList.add("spot-on")
      step.observe.forEach((id) => q("#" + id)?.classList.add("observe-on"))
    }, 260)

    bar.classList.remove("run"); void bar.offsetWidth
    bar.style.setProperty("--dur", DUR + "ms")
    if (playing) bar.classList.add("run")
  }
  function schedule() { clearTimeout(timer); if (playing) timer = setTimeout(() => go(idx + 1), DUR) }
  function go(n) { idx = (n + steps.length) % steps.length; render(); schedule() }
  function setPlaying(p) {
    playing = p; playPause.textContent = p ? "⏸" : "▶"
    if (p) { bar.classList.add("run"); schedule() } else { clearTimeout(timer); bar.classList.remove("run") }
  }
  prevBtn.addEventListener("click", () => go(idx - 1))
  nextBtn.addEventListener("click", () => go(idx + 1))
  playPause.addEventListener("click", () => setPlaying(!playing))

  render(); schedule()
</script>

<style>
  .vhw {
    --background: oklch(1 0 0); --foreground: oklch(0.145 0 0);
    --card: oklch(1 0 0); --card-foreground: oklch(0.145 0 0);
