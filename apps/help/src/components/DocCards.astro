---
/**
 * Guides as cards, the site's `.dp .cards` / `.card` (vendored doc-page.css): white, a soft
 * border and shadow, the whole card a link. Used on the home page under each category head
 * and under an article for its related guides.
 */
import Icon from "@/components/Icon.astro"
import { type Doc, docHref } from "@/lib/docs"

interface Props {
  docs: Doc[]
  /** Columns on a wide screen. */
  columns?: 2 | 3
}
const { docs, columns = 3 } = Astro.props
---

<div class="cards hc-cards" style={`--hc-cols:${columns}`}>
  {
    docs.map((doc) => (
      <a class="card hc-card" href={docHref(doc)}>
        <span class="hc-card-t">{doc.data.title}</span>
        <span class="hc-card-d">{doc.data.description}</span>
        <Icon name="chevron-right" size={16} class="hc-card-arrow" />
      </a>
    ))
  }
</div>

<style>
  .hc-cards {
    grid-template-columns: repeat(var(--hc-cols), minmax(0, 1fr));
  }
  .hc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 40px 18px 18px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .hc-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift-hover);
    border-color: var(--ink);
  }
  .hc-card-t {
    font-size: 15.5px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .hc-card-d {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .hc-card :global(.hc-card-arrow) {
    position: absolute;
    top: 20px;
    right: 16px;
    color: var(--muted);
  }
  @media (max-width: 1000px) {
    .hc-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .hc-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
