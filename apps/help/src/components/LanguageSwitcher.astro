---
import { LOCALES } from "@/consts"
import { localeNames, useTranslations } from "@/i18n/ui"
import { getLocaleFromPath, switchLocalePath } from "@/i18n/utils"

const current = getLocaleFromPath(Astro.url.pathname)
const t = useTranslations(current)
---

{/* The bayesimpact.org globe dropdown (@bayes/ui lang-switcher.css): globe, current code,
    chevron, and a menu of full names, the active one marked. */}
<div
  class="lang-toggle"
  role="button"
  tabindex="0"
  aria-haspopup="true"
  aria-expanded="false"
  aria-label={t("lang.label")}
  data-lang-switcher
>
  <svg class="lang-globe" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
  <span>{current.toUpperCase()}</span>
  <svg class="lang-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  <div class="lang-menu" role="menu">
    {
      LOCALES.map((locale) => (
        <a
          href={switchLocalePath(Astro.url.pathname, locale)}
          role="menuitem"
          class:list={{ active: locale === current }}
          aria-current={locale === current ? "true" : undefined}
        >
          {localeNames[locale]}
        </a>
      ))
    }
  </div>
</div>

<script is:inline>
  document.querySelectorAll("[data-lang-switcher]").forEach((toggle) => {
    const set = (open) => {
      toggle.classList.toggle("open", open)
      toggle.setAttribute("aria-expanded", String(open))
    }
    toggle.addEventListener("click", (event) => {
      if (event.target.closest(".lang-menu a")) return
      event.stopPropagation()
      set(!toggle.classList.contains("open"))
    })
    toggle.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault()
        set(!toggle.classList.contains("open"))
      }
    })
    document.addEventListener("click", () => set(false))
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") set(false)
    })
  })
</script>
