---
/**
 * Walkthrough of the agent's Embed settings (a conversation agent as a chat widget, a public
 * page or a public API). Derived from the real components (verified, not copied blind):
 * AgentActions.tsx (Edit on the agent page), AgentEditorPageView.tsx (Embed under "More",
 * flag `agent-embed`, conversation agents only), AgentEditorSheet.tsx (full-page sheet,
 * Cancel and Save, the confirmation before it applies in production) and EmbedSheet.tsx
 * (Enable embed, Appearance, Widget on a website with Allowed origins, Public page, Public
 * API). Labels verbatim from the agentSettings / agent / actions locales (EN + FR).
 * Uses the PRODUCT (coral) palette, pinned locally. Derived 2026-07-16, updated 2026-09-07,
 * rebuilt for the editor page and its sheets 2026-11-16.
 */
type Lang = "en" | "fr"
const { lang = "en" } = Astro.props as { lang?: Lang }

// Split the tag so Vite's HTML scanner does not treat this string as a real script element.
const SNIPPET =
  "<scr" + 'ipt src="https://app.example.com/launcher.js" data-token="emb_1a2b3c4d"></scr' + "ipt>"
const PUBLIC_PAGE_URL = "https://app.example.com/index.html?embedToken=emb_1a2b3c4d&displayMode=drawer"
const API_BASE_URL = "https://api.example.com/public/v1/agents/emb_1a2b3c4d"

