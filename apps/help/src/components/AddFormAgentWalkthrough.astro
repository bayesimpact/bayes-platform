---
/**
 * Animated, full-page walkthrough of the "add a form agent" flow, mirroring the
 * real Studio interface (same shell, exact Lucide icons, real brand logo). Shares
 * the exact FORM of the other help-center walkthroughs — only the content differs.
 * Pass `lang="fr"` for the French copy.
 *
 * Re-derived 2026-11-16 from AgentCreator.tsx, agent-form.shared.ts, AgentEditor.tsx,
 * AgentEditorPageView.tsx and ToolsTab.tsx: the Form choice creates a conversation agent with
 * the Form filling tool on, so its editor is a conversation agent's (General, Model, Sources,
 * Tools, then MCP Servers, Orchestration and Embed under "More") and the form's fields live
 * in Tools > Form filling. Every change saves by itself to the draft (AgentEditorSaveStatus):
 * no Save button, no Locale field.
 */
type Lang = "en" | "fr"
const { lang = "en" } = Astro.props as { lang?: Lang }

const SCHEMA = `{
  "type": "object",
  "properties": {
    "fullName": { "type": "string" },
    "email": { "type": "string" }
  },
  "required": ["fullName", "email"]
}`

const STRINGS = {
  en: {
    org: "Bayes Impact Demo", studio: "Studio", agents: "Agents",
    agent1: "Bayes Assistant", conversationAgent: "Conversation Agent", extractionAgent: "Extraction Agent", formAgent: "Form Agent",
    settingsName: "Demo", settings: "Settings", evaluations: "Evaluations", analytics: "Analytics", sources: "Sources",
    documents: "Documents", resourceLibraries: "Resource libraries", members: "Members", admin: "Admin",
    userName: "Alex Martin", userEmail: "alex.martin@example.com",
    conversation: "Conversation", extraction: "Extraction", form: "Form",
    newAgent: "New Agent", newAgentDesc: "An agent can perform specific tasks based on its type and configuration.",
    create: "Create",
    dialogDesc: "Choose the type before configuring your agent.",
    typeLabel: "Agent type", typeConversation: "Conversation", typeExtraction: "Extraction", typeForm: "Form",
    nameLabel: "Name", namePlaceholder: "Enter agent name", agentName: "Contact Form",
    editTitle: "Edit Conversation Agent",
    back: "Back", more: "More", manage: "Manage versions", draftSaved: "Draft saved",
    secGeneral: "General", secModel: "Model", secSources: "Sources", secTools: "Tools",
    secMcpServers: "MCP Servers", secOrchestration: "Orchestration", secEmbed: "Embed",
    greetingLabel: "Greeting", greetingValue: "Hi! I'll help you fill out this form. Let's get started.", greetingCount: "56 / 2,000 characters",
    promptLabel: "Instructions", promptCount: "124 characters",
    genTitle: "Answer generation", genDesc: "The model that writes the agent's answers.", modelValue: "Gemini 3.5 Flash (Vertex3)",
    fillFormTitle: "Form filling", fillFormDesc: "Let the agent fill a structured form from the user's answers during the conversation.",
    schemaDesc: "Define the form fields the agent should fill. The field order is the order in which the agent asks its questions.",
    promptValue: "Your main task is to help the user fill out the form by asking questions and providing guidance. Ask one question at a time.",
    modelLabel: "Model", modelPlaceholder: "Select model", tempLabel: "Temperature", tempValue: "0.2",
    save: "Save",
    formConfigLabel: "Form Configuration", schemaValue: SCHEMA,
    builderAdvanced: "Advanced mode", builderAddField: "Add field",
    orderToggle: "Ask questions in this order",
    bName: "Field name", bType: "Type", bReq: "Required",
    tText: "Text", tNumber: "Number", tYesNo: "Yes / No",
    field1: "full_name", field2: "email",
    update: "Update",
    prev: "Prev", next: "Next", step: "Step",
    steps: [
      "On the workspace overview, open the New Agent card and click Create.",
      "In the New Agent dialog, choose the Form type.",
      "Give your agent a name, then click Create. The agent editor opens.",
      "General: set the Name, Greeting and Instructions. Each change saves to the draft by itself, and the status reads Draft saved.",
      "Model: choose the Model and its options, such as the Temperature.",
      "Tools: Form filling is on. Add the fields to collect, set Required, and drag to order the questions.",
      "Prefer JSON? Advanced mode opens the raw schema editor.",
      "When the draft is ready, click Manage versions, then Save version. Users then talk to the new version.",
    ],
  },
  fr: {
    org: "Bayes Impact Demo", studio: "Studio", agents: "Agents",
    agent1: "Bayes Assistant", conversationAgent: "Conversation Agent", extractionAgent: "Extraction Agent", formAgent: "Form Agent",
    settingsName: "Demo", settings: "Paramètres", evaluations: "Évaluations", analytics: "Analytique", sources: "Sources",
    documents: "Documents", resourceLibraries: "Bibliothèques de ressources", members: "Membres", admin: "Admin",
    userName: "Alex Martin", userEmail: "alex.martin@example.com",
    conversation: "Conversation", extraction: "Extraction", form: "Formulaire",
    newAgent: "Nouvel agent", newAgentDesc: "Un agent peut effectuer des tâches spécifiques en fonction de son type et de sa configuration.",
    create: "Créer",
    dialogDesc: "Choisissez le type avant de configurer votre agent.",
    typeLabel: "Type d'agent", typeConversation: "Conversation", typeExtraction: "Extraction", typeForm: "Formulaire",
    nameLabel: "Nom", namePlaceholder: "Entrez le nom de l'agent", agentName: "Contact Form",
    editTitle: "Modifier l'agent conversationnel",
    back: "Retour", more: "Plus", manage: "Gérer les versions", draftSaved: "Brouillon enregistré",
    secGeneral: "Général", secModel: "Modèle", secSources: "Sources", secTools: "Outils",
    secMcpServers: "Serveurs MCP", secOrchestration: "Orchestration", secEmbed: "Intégration",
    greetingLabel: "Message d'accueil", greetingValue: "Bonjour ! Je vais vous aider à remplir ce formulaire. Commençons.", greetingCount: "65 / 2\u202f000 caractères",
    promptLabel: "Instructions", promptCount: "144 caractères",
    genTitle: "Génération des réponses", genDesc: "Le modèle qui rédige les réponses de l'agent.", modelValue: "Gemini 3.5 Flash (Vertex3)",
    fillFormTitle: "Remplissage de formulaire", fillFormDesc: "Permet à l'agent de remplir un formulaire structuré à partir des réponses de l'utilisateur pendant la conversation.",
    schemaDesc: "Définissez les champs du formulaire que l'agent doit remplir. L'ordre des champs est l'ordre dans lequel l'agent pose ses questions.",
    promptValue: "Votre tâche principale est d'aider l'utilisateur à remplir le formulaire en posant des questions et en le guidant. Posez une question à la fois.",
    modelLabel: "Modèle", modelPlaceholder: "Sélectionnez le modèle", tempLabel: "Température", tempValue: "0.2",
    save: "Enregistrer",
    formConfigLabel: "Configuration du formulaire", schemaValue: SCHEMA,
    builderAdvanced: "Mode avancé", builderAddField: "Ajouter un champ",
    orderToggle: "Poser les questions dans cet ordre",
    bName: "Nom du champ", bType: "Type", bReq: "Obligatoire",
    tText: "Texte", tNumber: "Nombre", tYesNo: "Oui / Non",
    field1: "full_name", field2: "email",
    update: "Mettre à jour",
    prev: "Précédent", next: "Suivant", step: "Étape",
    steps: [
      "Sur la vue d'ensemble de l'espace de travail, ouvrez la carte Nouvel agent et cliquez sur Créer.",
      "Dans la boîte de dialogue Nouvel agent, choisissez le type Formulaire.",
      "Donnez un nom à votre agent, puis cliquez sur Créer. L'éditeur de l'agent s'ouvre.",
      "Général : définissez le Nom, le Message d'accueil et les Instructions. Chaque modification s'enregistre d'elle-même dans le brouillon, et le statut affiche Brouillon enregistré.",
      "Modèle : choisissez le Modèle et ses options, comme la Température.",
      "Outils : le Remplissage de formulaire est activé. Ajoutez les champs à collecter, réglez Obligatoire, et glissez pour ordonner les questions.",
      "Vous préférez le JSON ? Le Mode avancé ouvre l'éditeur de schéma brut.",
      "Quand le brouillon est prêt, cliquez sur Gérer les versions, puis sur Enregistrer la version. Les utilisateurs parlent alors à la nouvelle version.",
    ],
  },
} as const

const s = STRINGS[lang]

const steps = [
  { page: "overview", sec: "", spot: "btnCreate", observe: [] },
  { page: "typeDialog", sec: "", spot: "btnTypeForm", observe: ["obsTypeRow"] },
  { page: "typeDialog", sec: "", spot: "btnCreateConfirm", observe: ["obsNameField"] },
  { page: "editorGeneral", sec: "general", spot: "", observe: ["obsGeneral", "obsStatus"] },
  { page: "editorModel", sec: "model", spot: "sec-model", observe: ["obsModel"] },
  { page: "editorTools", sec: "tools", spot: "sec-tools", observe: ["obsSchema"] },
  { page: "editorTools", sec: "tools", spot: "btnAdvanced", observe: [] },
  { page: "editorTools", sec: "tools", spot: "btnManage", observe: ["obsStatus"] },
].map((step, i) => ({ ...step, text: s.steps[i] }))

const titles = { general: s.secGeneral, model: s.secModel, tools: s.secTools }

const labels = { prev: s.prev, next: s.next, step: s.step }
---

<div class="faw" role="group" aria-label={s.newAgent}>
  <div class="shell">
    <!-- Sidebar -->
    <aside class="sb">
      <div class="sb-head">
        <span class="logo"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 410.85 405.35" aria-hidden="true"><path d="M366.77,161.43H247V41.61a41.37,41.37,0,1,0-82.74,0V161.43H44.39a41.37,41.37,0,0,0,0,82.74H164.21V364A41.37,41.37,0,1,0,247,364V244.17H366.77a41.37,41.37,0,1,0,0-82.74Z"/><circle cx="205.58" cy="364.27" r="41.05"/><circle cx="369.79" cy="202.64" r="41.05"/><circle cx="41.05" cy="202.64" r="41.05"/><circle cx="205.58" cy="41.05" r="41.05"/><circle cx="205.58" cy="202.64" r="41.05"/></svg></span>
        <span class="org"><b>{s.org}</b><small>{s.studio}</small></span>
      </div>
      <div class="sb-scroll">
        <div class="grp-label">{s.agents}<span class="add" id="navAdd"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg></span></div>
        <div class="navitem hidden" id="navNewAgent"><svg viewBox="0 0 24 24"><path d="M4 14h6"/><path d="M4 2h10"/><rect x="4" y="18" width="16" height="4" rx="1"/><rect x="4" y="6" width="16" height="4" rx="1"/></svg><span>{s.agentName}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M12 6V2H8"/><path d="m8 18-4 4V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2Z"/><path d="M9 11v2"/><path d="M15 11v2"/></svg><span>{s.agent1}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M12 6V2H8"/><path d="m8 18-4 4V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2Z"/><path d="M9 11v2"/><path d="M15 11v2"/></svg><span>{s.conversationAgent}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M7 8h8"/><path d="M7 12h10"/><path d="M7 16h6"/></svg><span>{s.extractionAgent}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M4 14h6"/><path d="M4 2h10"/><rect x="4" y="18" width="16" height="4" rx="1"/><rect x="4" y="6" width="16" height="4" rx="1"/></svg><span>{s.formAgent}</span></div>

        <div class="grp-label stack"><span class="name">{s.settingsName}</span><span>{s.settings}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg><span>{s.evaluations}</span><svg class="chev" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg><span>{s.analytics}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 15 21.84"/><path d="M21 5V8"/><path d="M21 12L18 17H22L19 22"/><path d="M3 12A9 3 0 0 0 14.59 14.87"/></svg><span>{s.sources}</span><svg class="chev" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg><span>{s.members}</span></div>
        <div class="navitem"><svg viewBox="0 0 24 24"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg><span>{s.admin}</span></div>
      </div>
      <div class="sb-user">
        <span class="avatar">AM</span>
        <span class="who"><b>{s.userName}</b><small>{s.userEmail}</small></span>
        <span class="updown"><svg viewBox="0 0 24 24"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg></span>
      </div>
    </aside>

    <!-- The agent editor's own menu, in place of the Studio sidebar -->
    <aside class="esb">
      <span class="ebk"><svg viewBox="0 0 24 24"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> {s.back}</span>
      <div class="agent-id"><b><svg viewBox="0 0 24 24"><path d="M12 6V2H8"/><path d="m8 18-4 4V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2Z"/><path d="M9 11v2"/><path d="M15 11v2"/></svg><span>{s.agentName}</span></b><small>{s.editTitle}</small></div>
      <div class="esb-list">
        <div class="navitem" data-sec="general" id="sec-general"><svg viewBox="0 0 24 24"><path d="M10 5H3"/><path d="M12 19H3"/><path d="M14 3v4"/><path d="M16 17v4"/><path d="M21 12h-9"/><path d="M21 19h-5"/><path d="M21 5h-7"/><path d="M8 10v4"/><path d="M8 12H3"/></svg><span>{s.secGeneral}</span></div>
        <div class="navitem" data-sec="model" id="sec-model"><svg viewBox="0 0 24 24"><path d="M12 20v2"/><path d="M12 2v2"/><path d="M17 20v2"/><path d="M17 2v2"/><path d="M2 12h2"/><path d="M2 17h2"/><path d="M2 7h2"/><path d="M20 12h2"/><path d="M20 17h2"/><path d="M20 7h2"/><path d="M7 20v2"/><path d="M7 2v2"/><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="8" y="8" width="8" height="8" rx="1"/></svg><span>{s.secModel}</span></div>
        <div class="navitem" data-sec="sources" id="sec-sources"><svg viewBox="0 0 24 24"><rect width="8" height="18" x="3" y="3" rx="1"/><path d="M7 3v18"/><path d="M20.4 18.9c.2.5-.1 1.1-.6 1.3l-1.9.7c-.5.2-1.1-.1-1.3-.6L11.1 5.1c-.2-.5.1-1.1.6-1.3l1.9-.7c.5-.2 1.1.1 1.3.6Z"/></svg><span>{s.secSources}</span></div>
        <div class="navitem" data-sec="tools" id="sec-tools"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></svg><span>{s.secTools}</span></div>
        <div class="grp-more">{s.more}</div>
        <div class="navitem" data-sec="mcpServers" id="sec-mcpServers"><svg viewBox="0 0 24 24"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg><span>{s.secMcpServers}</span></div>
        <div class="navitem" id="sec-orchestration"><svg viewBox="0 0 24 24"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg><span>{s.secOrchestration}</span><svg class="ext" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></div>
        <div class="navitem" id="sec-embed"><svg viewBox="0 0 24 24"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg><span>{s.secEmbed}</span><svg class="ext" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></div>
      </div>
      <div class="esb-foot"><span class="btn wide" id="btnManage"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg> {s.manage}</span></div>
    </aside>

    <!-- Main inset -->
    <div class="inset">
      <div class="topbar">
        <span class="trig"><svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg></span>
        <span class="etop"><span class="sec" data-sectitle></span><span class="status" id="obsStatus"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg> {s.draftSaved}</span></span>
      </div>
      <div class="canvas">
        <span class="fab"><svg viewBox="0 0 24 24"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg></span>

        <!-- workspace overview (step 1) -->
        <div class="page" data-page="overview" data-active="true">
          <div class="page-head plain">
            <span><span class="ttl">{s.settingsName}</span><span class="desc">{s.studio}</span></span>
          </div>
          <div class="cards3">
            <div class="ecard"><span class="cat">{s.conversation}</span><b class="ic"><svg viewBox="0 0 24 24"><path d="M12 6V2H8"/><path d="m8 18-4 4V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2Z"/><path d="M9 11v2"/><path d="M15 11v2"/></svg> {s.agent1}</b><span class="arrowbtn"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
            <div class="ecard"><span class="cat">{s.form}</span><b class="ic"><svg viewBox="0 0 24 24"><path d="M4 14h6"/><path d="M4 2h10"/><rect x="4" y="18" width="16" height="4" rx="1"/><rect x="4" y="6" width="16" height="4" rx="1"/></svg> {s.formAgent}</b><span class="arrowbtn"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span></div>
            <div class="ecard muted">
              <b>{s.newAgent}</b>
              <p>{s.newAgentDesc}</p>
              <span class="btn sm" id="btnCreate">{s.create} <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg></span>
            </div>
          </div>
        </div>

        <!-- New Agent dialog (steps 2 & 3) -->
        <div class="page" data-page="typeDialog">
          <div class="scrim"></div>
          <div class="modal">
            <div class="mhead"><b>{s.newAgent}</b><p>{s.dialogDesc}</p></div>
            <p class="lbl">{s.typeLabel}</p>
            <div class="typegrid" id="obsTypeRow">
              <span class="typebtn">{s.typeConversation}</span>
              <span class="typebtn">{s.typeExtraction}</span>
              <span class="typebtn on" id="btnTypeForm">{s.typeForm}</span>
            </div>
            <p class="lbl">{s.nameLabel}</p>
            <div id="obsNameField"><span class="input block">{s.agentName}</span></div>
            <div class="row" style="margin-top:1rem"><span class="btn wide" id="btnCreateConfirm">{s.create}</span></div>
          </div>
        </div>

        <!-- editor: General tab (step 4) -->
        <div class="page" data-page="editorGeneral">
          <div class="editor">
            <div class="tabbody" id="obsGeneral">
              <div class="grid2">
                <div class="fld"><p class="lbl">{s.nameLabel}</p><span class="input block">{s.agentName}</span></div>
              </div>
              <div class="fld"><p class="lbl">{s.greetingLabel}<span class="count">{s.greetingCount}</span></p><span class="textarea mono">{s.greetingValue}</span></div>
              <div class="fld"><p class="lbl">{s.promptLabel}<span class="count">{s.promptCount}</span></p><span class="textarea mono grow">{s.promptValue}</span></div>
            </div>
          </div>
        </div>

        <!-- editor: Model tab (step 5) -->
        <div class="page" data-page="editorModel">
          <div class="editor">
            <div class="tabbody sect" id="obsModel">
              <p class="lbl sect-ttl">{s.genTitle}</p>
              <p class="hint">{s.genDesc}</p>
              <div class="grid2">
                <div class="fld"><p class="lbl">{s.modelLabel}</p><span class="select"><span>{s.modelValue}</span><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></span></div>
                <div class="fld"><p class="lbl">{s.tempLabel}</p><span class="input block">{s.tempValue}</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- editor: Tools, the Form filling tool (steps 6 to 8) -->
        <div class="page" data-page="editorTools">
          <div class="editor">
            <div class="tabbody toolcard" id="obsSchema">
              <div class="tc-head"><span><b>{s.fillFormTitle}</b><p class="hint">{s.fillFormDesc}</p></span><span class="switch on"><i></i></span></div>
              <p class="hint">{s.schemaDesc}</p>
              <div class="builder-top"><span class="modebtn" id="btnAdvanced"><svg viewBox="0 0 24 24"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg> {s.builderAdvanced}</span></div>
              <div class="ordertoggle"><span class="switch on"><i></i></span><span>{s.orderToggle}</span></div>
              <div class="sbuilder">
                <div class="sb-head"><span></span><span class="ta-c">#</span><span>{s.bName}</span><span>{s.bType}</span><span class="ta-c">{s.bReq}</span><span></span></div>
                <div class="sb-row">
                  <span class="grip"><svg viewBox="0 0 24 24"><circle cx="9" cy="6" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="6" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="18" r="1"/></svg></span>
                  <span class="ta-c num">1</span>
                  <span class="input block mono">{s.field1}</span>
                  <span class="select"><span>{s.tText}</span><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></span>
