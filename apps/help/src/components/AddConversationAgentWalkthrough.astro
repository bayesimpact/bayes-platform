    subToolName: "ask_support_agent", subToolDesc: "Transmettre les demandes spécialisées à Support Agent.", subAgentName: "Support Agent",
    embedEnabled: "Activer l'intégration", embedEnabledDesc: "Rend Helpful Assistant disponible hors de la plateforme : widget, page publique et API publique. Désactivée, les trois cessent de fonctionner.",
