  .caw .mhead p { font-size: 0.78rem; color: var(--muted-foreground); margin: 0.2rem 0 0; }
  .caw .typegrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .caw .typebtn { border: 1px solid var(--border); border-radius: 8px; padding: 0.5rem 0.4rem; font-size: 0.8rem; text-align: center; color: var(--foreground); background: var(--background); }
  .caw .typebtn.on { border-color: var(--primary); color: var(--primary); font-weight: 600; }

