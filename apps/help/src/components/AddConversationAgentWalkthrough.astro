  .caw .observe-on { outline: 2px dashed var(--spot); outline-offset: 3px; border-radius: 10px; }

  .caw .btn { display: inline-flex; align-items: center; gap: 0.35rem; background: var(--primary); color: var(--primary-foreground); border-radius: 8px; font-size: 0.8rem; font-weight: 500; padding: 0.4rem 0.7rem; }
  .caw .btn svg { font-size: 0.95rem; }
  .caw .btn.sm { font-size: 0.76rem; padding: 0.32rem 0.55rem; }
  .caw .btn.outline { background: var(--background); color: var(--foreground); border: 1px solid var(--border); }
  .caw .btn.wide { width: 100%; justify-content: center; }

  .caw .page-head { border-bottom: 1px solid var(--border); padding-bottom: 0.9rem; margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 0.7rem; }
  .caw .page-head.plain { border: 0; }
  .caw .backbtn { width: 1.9rem; height: 1.9rem; border: 1px solid var(--border); border-radius: 8px; display: inline-grid; place-items: center; color: var(--muted-foreground); flex-shrink: 0; }
  .caw .ttl { font-size: 1.3rem; font-weight: 600; line-height: 1.15; display: block; }
  .caw .desc { font-size: 0.88rem; color: var(--muted-foreground); margin-top: 0.2rem; display: block; }

  .caw .cards3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
  .caw .ecard { border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); padding: 0.8rem; min-height: 116px; display: flex; flex-direction: column; }
  .caw .ecard.muted { background: color-mix(in oklab, var(--muted) 35%, var(--card)); }
  .caw .ecard .cat { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted-foreground); font-weight: 600; margin-bottom: 0.2rem; }
  .caw .ecard b { font-size: 0.88rem; }
  .caw .ecard b.ic { display: flex; align-items: center; gap: 0.35rem; }
  .caw .ecard b.ic svg { color: var(--muted-foreground); font-size: 0.95rem; }
  .caw .ecard p { font-size: 0.74rem; color: var(--muted-foreground); margin: 0.2rem 0 0.6rem; }
  .caw .ecard .arrowbtn, .caw .ecard .btn { margin-top: auto; align-self: flex-start; }
  .caw .arrowbtn { width: 1.8rem; height: 1.8rem; border: 1px solid var(--border); border-radius: 8px; display: inline-grid; place-items: center; color: var(--muted-foreground); }

  .caw .lbl { font-size: 0.78rem; font-weight: 500; margin: 0.6rem 0 0.3rem; }
  .caw .row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .caw .input { border: 1px solid var(--input); border-radius: 8px; padding: 0.42rem 0.6rem; font-size: 0.8rem; color: var(--foreground); background: var(--background); }
  .caw .input.block { display: block; }
  .caw .input.mono, .caw .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .caw .select { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; border: 1px solid var(--input); border-radius: 8px; padding: 0.42rem 0.6rem; font-size: 0.8rem; color: var(--foreground); background: var(--background); }
  .caw .select.muted-select, .caw .input.muted-select { color: var(--muted-foreground); }
  .caw .select svg { color: var(--muted-foreground); font-size: 0.95rem; }
  .caw .textarea { display: block; border: 1px solid var(--input); border-radius: 8px; padding: 0.55rem 0.7rem; font-size: 0.78rem; color: var(--foreground); background: var(--background); line-height: 1.5; }
