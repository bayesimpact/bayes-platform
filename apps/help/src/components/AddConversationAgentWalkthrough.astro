---
/**
 * Walkthrough of the "add a conversation agent" flow. Derived from the real
 * components (verified, not copied blind): AgentCreator.tsx (dialog),
 * AgentEditor.tsx (sections, sheets and their conditions), AgentEditorPageView.tsx (the
 * editor as a page of its own: Back, agent name, draft sections, the "More" group, the
 * "Manage versions" button, the save status in the header), AgentEditorSaveStatus.tsx,
 * GeneralTab.tsx (character counts, Advanced mode), ModelTab.tsx, SourcesTab.tsx,
 * ToolsTab.tsx, SessionCategoriesTab.tsx, AgentEditorSheet.tsx (full-page sheet with Cancel
 * and Save, then a confirmation), OrchestrationSheet.tsx and EmbedSheet.tsx. Labels are
 * verbatim from the agent / agentSettings / resourceLibrary / actions locales (EN + FR).
 * Depicts the fully-provisioned conversation agent: categories, MCP servers, orchestration
 * and embed enabled. Uses the PRODUCT (coral) palette, pinned locally.
 * Derived 2026-07-13, rebuilt for the editor page and its automatic save 2026-11-16.
 */
type Lang = "en" | "fr"
const { lang = "en" } = Astro.props as { lang?: Lang }

