TZ='UTC'

LOG_LEVEL=debug # fatal | error | warn | log | debug | verbose (default: log)
OTEL_CONSOLE_EXPORT=false # print OTEL spans to stdout (default: false)
DIAGNOSTICS_SECRET=change-me # secret path for /diagnostics/<secret>/test-error

# Port the API listens on (default 3000). Override to run several API instances
# side by side.
PORT=3000
# On SIGTERM the API stops accepting connections and waits this long for the
# requests in flight before exiting (Kubernetes gives the pod 35 s in the
# chart, Cloud Run 10 s: set it below the grace period of the platform).
# Default 25000.
# API_SHUTDOWN_TIMEOUT_MS=25000

GOOGLE_APPLICATION_CREDENTIALS=../../dontsave/caseai-connect-XXX.json

# Traces and metrics over OTLP to an OpenTelemetry Collector (optional, nothing is
# exported when unset), and the link to one of our trace ids in the trace backend.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=api
# TRACE_URL_TEMPLATE=https://traces.example.org/redirects/sessions/{traceId}

#Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=connect_admin
DATABASE_PASSWORD=passpass
DATABASE_NAME=connect
DATABASE_LOGGING=false

# OpenID Connect provider (Keycloak, Auth0, Okta...). The API reads the
# JWKS and userinfo endpoints from {OIDC_ISSUER_URL}/.well-known/openid-configuration.
# OIDC_ISSUER_URL must equal the `iss` claim of the access tokens (mind the trailing slash).
# Local oidc-picker: `docker compose --profile oidc-picker up -d oidc-picker` from
# infra/database (see infra/oidc-picker/README.md).
OIDC_ISSUER_URL=http://localhost:5556
# Checked against the `aud` claim when set. Leave it unset with the local oidc-picker.
# OIDC_AUDIENCE=platform-api
# People invited by email find their invitations at their first sign-in with that email.
# Linking requires `email_verified: true` unless OIDC_TRUST_UNVERIFIED_EMAIL=true, which is only
# acceptable for a single-tenant provider the customer fully controls.
# OIDC_ALLOW_EMAIL_LINKING=true
# OIDC_TRUST_UNVERIFIED_EMAIL=false
# Extra authorize parameters sent by the web app, as a JSON object of strings.
# Auth0 applications restricted to an organization need it: {"organization":"org_XXX"}
# OIDC_AUTHORIZATION_PARAMS=

# Apps V0 JWT (RS256). Required to boot the API.
# Paste each PEM on one line, replacing newlines with \n.
OAUTH_SIGNING_PRIVATE_KEY=
OAUTH_SIGNING_PUBLIC_KEY=

# File Storage Config
# STORAGE_BACKEND: s3 or local. Unset: local.
# s3 (the dev default): the machine's SeaweedFS, one bucket shared by the main checkout and every
# worktree environment, like the connect database. The worktree tooling starts it and creates
# the bucket. By hand, in infra/database:
#   docker compose --profile storage up -d --wait seaweedfs
#   echo 's3.bucket.create -name connect-documents' | docker compose exec -T seaweedfs weed shell
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:8333
# Endpoint the browsers reach, when it differs from S3_ENDPOINT (signed URLs embed the host).
S3_PUBLIC_ENDPOINT=
S3_BUCKET=connect-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=local-dev-secret-key
S3_FORCE_PATH_STYLE=true
# local: files on disk. Origin of this API (no path): upload URLs are built under /api on it.
LOCAL_STORAGE_SERVER_BASE_URL=https://connect.localhost:3000

# Document Embeddings
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=europe-west1
DOCUMENT_EMBEDDING_MODELS=gemini-embedding-001
# Local HuggingFace embedding models (feature flag "local-embeddings"). Workers only: the process
# must reach apps/api/bin/document_embedder (repo .venv with requirements-embeddings.txt
# installed, or the gpu-workers image). Off by default; the API never needs it.
# LOCAL_EMBEDDINGS_ENABLED=false
# DOCUMENT_EMBEDDER_COMMAND=apps/api/bin/document_embedder
# LOCAL_EMBEDDING_DEVICE=cuda           # cuda | mps | cpu, auto-detected when unset
# Chunks per embedding request. 128 suits the GPU pool; use 32 on a laptop (CPU or Apple Silicon).
# LOCAL_EMBEDDING_BATCH_SIZE=128
# LOCAL_EMBEDDING_REQUEST_TIMEOUT_MS=120000
# How long a chat turn waits for the GPU workers to embed the query before using the Vertex model.
# LOCAL_EMBEDDING_QUERY_TIMEOUT_MS=15000

# LLM fetch timeouts (ms), every provider — applied only to long-running calls that
# opt in (extraction agent runs). Optional; defaults shown below.
# LLM_FETCH_HEADERS_TIMEOUT_MS=1800000 # 30 minutes
# LLM_FETCH_BODY_TIMEOUT_MS=1800000 # 30 minutes
# LLM_FETCH_CONNECT_TIMEOUT_MS=30000 # 30 seconds

# Workers — mark queued/processing documents failed if unchanged longer than threshold (seconds). Sweep interval (seconds) must also be set. No defaults in app code.
DOCUMENT_EMBEDDING_STUCK_THRESHOLD_SECONDS=86400
DOCUMENT_EMBEDDING_STUCK_SWEEP_INTERVAL_SECONDS=900
# Optional override for the maintenance queue name (default: document-embeddings-stuck-sweep)
# DOCUMENT_EMBEDDINGS_STUCK_SWEEP_QUEUE_NAME=document-embeddings-stuck-sweep

# Workers — which queues this process consumes (comma-separated). REQUIRED; the
# process fails to start if unset or if a name is unknown. In production the GPU
# and CPU instance types each set their own subset; locally we run a single
# process that consumes every queue.
WORKER_QUEUE_NAMES=evaluation-extraction-run-queue,evaluation-extraction-run-execute-queue,evaluation-conversation-run-queue,evaluation-conversation-run-execute-queue,agent-csv-extraction-run-queue,agent-csv-extraction-run-execute-queue,extraction-agent-session-queue,document-embeddings,document-embeddings-stuck-sweep,project-embedding-reembed,query-embeddings,pdf-exports-sweep,maintenance-jobs
# On SIGTERM the workers stop taking jobs and wait this long for the jobs in
# progress before exiting (Kubernetes gives the pod 120 s, Cloud Run 10 s: set
# it below the grace period of the platform). Default 100000.
# WORKER_SHUTDOWN_TIMEOUT_MS=100000

# Workers — which queue the /healthz Redis ping uses. REQUIRED; must be one of
# the queues this instance consumes (see WORKER_QUEUE_NAMES).
WORKERS_HEALTH_QUEUE_NAME=document-embeddings

# BullMQ Redis connection (default redis://localhost:6379). Override to point at
# a different Redis instance.
BULLMQ_REDIS_URL=redis://localhost:6379

# MCP Server Encryption (64-char hex, 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_ENCRYPTION_KEY=your-64-char-hex-key-here

# Frontend callback URL registered with MCP OAuth providers
MCP_OAUTH_REDIRECT_URL=https://connect.localhost:5173/oauth/mcp/callback

# Local dev only: let MCP OAuth discovery reach http://localhost servers (production rejects non-public hosts).
# MCP_OAUTH_ALLOW_INSECURE_LOCAL=true

# Migrations only (SeedPlatformStaffByEmailDomain) — email domain granted the platform_staff role. Not read by the app at runtime.
ORGANIZATION_CREATOR_EMAIL_DOMAIN=@example.com

# Migrations only (SeedPlatformSuperadminByEmails) — comma-separated emails granted platform_superadmin (ex backoffice "see all"). Not read by the app at runtime.
BACKOFFICE_AUTHORIZED_EMAILS=admin@example.com,ops@example.com

# CORS — comma-separated list of allowed frontend origins.
FRONTEND_URL=https://connect.localhost:5173,https://connect.localhost:5174

# Invitation emails (optional). Without SMTP_HOST the platform sends no email:
# admins copy each invitation link from the members screens. Any SMTP server works.
# Uncomment one of the two blocks below.

# Dev: the Mailpit of infra/database (`docker compose --profile mail up -d mailpit`)
# catches every email and shows it at http://localhost:8025.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM="Platform <no-reply@connect.localhost>"

# Prod: your SMTP server. Port 465 uses TLS from the start, other ports STARTTLS;
# SMTP_SECURE=true or false overrides that.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=change-me
# SMTP_FROM="Platform <no-reply@example.org>"
# Name announced in EHLO, defaults to the host name. Some relays (Google Workspace)
# check it against the sender's domain.
# SMTP_HELO_NAME=example.org

# Public URL of the web app, for the links put in emails. Defaults to the first FRONTEND_URL entry.
# APP_PUBLIC_URL=https://connect.localhost:5173

# Public URL of the API, the base of the OAuth issuer and of the MCP endpoint URL
# (ADR 0028). Required when the web app and the API answer on different hosts.
# Defaults to the origin of each request, right when one host serves everything.
# API_PUBLIC_URL=https://connect.localhost:3000

# Name of the platform MCP server shown to MCP clients. Defaults to "Agent platform".
# MCP_SERVER_TITLE=AgentStudio

# --- PDF converter (apps/pdf-converter): renders pdf pages to png in GCS for image-only models (Gemma, MedGemma)
# Also enables the built-in "PDF export" MCP server: the API syncs its row at
# boot, pointing at <PDF_CONVERTER_URL>/mcp, and lists it in every project.
PDF_CONVERTER_URL=http://localhost:3002
# Set by terraform in production (Cloud Run invoker IAM); leave unset locally:
# PDF_CONVERTER_AUTH=google-iam

# Number of evaluation extraction record jobs a worker processes concurrently (default: 10).
# EVALUATION_EXTRACTION_RUN_CONCURRENCY=10

# Number of agent csv extraction record jobs a worker processes concurrently (default: 10).
# AGENT_CSV_EXTRACTION_RUN_CONCURRENCY=10


#Settings for vLLM deployed ai providers
#Each provider should have both the keys : VLLM_xxx_URL and VLLM_xxx_APIKEY (where xxx is the uppercase name of the corresponding value in the enum AgentModel)
#By example, AgentModel.Gemma4_26B will need VLLM_GEMMA4_26B_URL and VLLM_GEMMA4_26B_APIKEY
VLLM_xxx_URL="the-url-of-the-vllm-api-endpoint"
#If no api key is required, just set VLLM_xxx_APIKEY="<not used>"
VLLM_xxx_API="<not used>"

# Built-in PDF export: TTL sweep of temporary exports written by apps/pdf-converter (workers only)
# PDF_EXPORT_SWEEP_INTERVAL_SECONDS=300
# PDF_EXPORT_TTL_MINUTES=15
# PDF_EXPORT_TMP_PREFIX=tmp/pdf-exports/
# Required by every worker process (no default in code); must match the name listed in WORKER_QUEUE_NAMES.
PDF_EXPORTS_SWEEP_QUEUE_NAME=pdf-exports-sweep

# Web front served by the API (app-runtime image only). Unset locally: `vite dev` serves the front.
# WEB_APP_DIST_DIR=/app/apps/web/dist
# Browser configuration injected into index.html as window.__CONFIG__ (public values only).
# Defaults: same origin for the API, OIDC authority and audience taken from the OIDC_* values above.
# WEB_OIDC_CLIENT_ID=platform-web    # required: the SPA public client (code flow + PKCE), not the API one
# WEB_OIDC_AUTHORITY=                # only when the browser reaches the provider on another URL
# WEB_OIDC_SCOPE=openid profile email offline_access
# WEB_OIDC_AUTHORIZATION_PARAMS=     # only to override OIDC_AUTHORIZATION_PARAMS for the web app
# WEB_API_URL=                       # empty = same origin
# WEB_APP_TITLE=AgentStudio
# WEB_HELP_CENTER_URL=
# WEB_AGENT_EMBED_URL=
# WEB_HELP_AGENT_EMBED_TOKEN=
# WEB_HELP_AGENT_EMBED_COLOR=
# WEB_HELP_AGENT_EMBED_HINT=
# WEB_API_TIMEOUT_MS=10000
# Shown in the web user menu. Set by the Helm chart (deployed image tag) and the image build (commit).
# APP_VERSION=26.10.7
# GIT_SHA=
# WEB_DEFAULT_CONVERSATION_AGENT_PROMPT= (base64, same as the VITE_DEFAULT_* values of apps/web)
