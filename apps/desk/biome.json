{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!src/routeTree.gen.ts"]
  },
  "plugins": [
    "./biome-plugins/use-query-justified.grit",
    "./biome-plugins/no-effect-setting-state.grit",
    "./biome-plugins/table-without-memo.grit"
  ],
  "linter": {
    "rules": {
      "style": {
        "noEnum": "error",
        "noNonNullAssertion": "error",
        "noDefaultExport": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error"]
          }
        }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 200,
            "skipBlankLines": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["*.config.ts", ".storybook/**", "**/*.stories.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.spec.ts", "**/*.spec.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    }
  ]
}
