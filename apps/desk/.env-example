# The Desk's sign-in in local dev. The API injects these values at runtime when it serves the Desk;
# these build-time values are the fallback for `npm run dev`. Nothing here is secret.
VITE_OIDC_AUTHORITY=http://localhost:5556
VITE_OIDC_CLIENT_ID=platform-web
#VITE_OIDC_AUDIENCE=
#VITE_OIDC_SCOPE=
#VITE_OIDC_AUTHORIZATION_PARAMS={"organization":"org_123"}

# Where `npm run dev` forwards /api. Defaults to the local API, over HTTPS when apps/api/.certs exists.
#DESK_API_PROXY_TARGET=http://localhost:3000
