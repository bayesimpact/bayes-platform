# Copy to .env, then `npm run dev` at the repository root starts the service.
# Missing values fall back to the defaults documented in README.md.

# The bucket the service reads PDFs from and writes page images and exports to:
# the same as the API, with the same variables (see apps/api/.env-example).
# STORAGE_BACKEND: s3 or gcs. Unset: gcs when GCS_STORAGE_BUCKET_NAME is set.

# s3 (local SeaweedFS from infra/database, profile `storage`):
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://localhost:8333
# S3_PUBLIC_ENDPOINT=
# S3_BUCKET=connect-documents
# S3_ACCESS_KEY_ID=local-dev-access-key
# S3_SECRET_ACCESS_KEY=local-dev-secret-key
# S3_FORCE_PATH_STYLE=true

# gcs: dev bucket and a service account with access to it. Relative paths resolve from apps/pdf-converter.
GCS_STORAGE_BUCKET_NAME=test-connect-file-storage
GOOGLE_APPLICATION_CREDENTIALS=../../dontsave/caseai-connect-XXX.json

# Must match PDF_CONVERTER_URL in apps/api/.env (default http://localhost:3002).
# PORT=3002
