          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(sum(input_tokens + output_tokens + cache_read_tokens + cache_write_tokens + reasoning_tokens), 0) FROM analytics.llm_usage WHERE created_at > now() - interval '7 days' AND organization_id IN (${organization:sqlstring}) AND project_id IN (${project:sqlstring})"
