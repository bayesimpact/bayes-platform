      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0 * coalesce(sum(cache_read_tokens), 0) / NULLIF(coalesce(sum(input_tokens), 0), 0), 1) FROM analytics.llm_usage WHERE created_at > now() - interval '7 days' AND organization_id IN (${organization:sqlstring}) AND project_id IN (${project:sqlstring})"
        }
      ],
