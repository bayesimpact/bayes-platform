    {
      "id": 12,
      "type": "table",
      "title": "Cost by workspace, 7 days",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT organization_name AS organization,\n project_name AS workspace,\n round(coalesce(sum(cost), 0), 2) AS \"cost 7d\",\n coalesce(sum(input_tokens), 0) AS \"input tokens\",\n coalesce(sum(output_tokens), 0) AS \"output tokens\",\n coalesce(sum(cache_read_tokens), 0) AS \"cache read\",\n count(*) AS calls\n FROM analytics.llm_usage\n WHERE created_at > now() - interval '7 days' AND organization_id IN (${organization:sqlstring}) AND project_id IN (${project:sqlstring})\n GROUP BY 1, 2, 3, 4, 5, 6\n ORDER BY \"cost 7d\" DESC"
        }
      ],
