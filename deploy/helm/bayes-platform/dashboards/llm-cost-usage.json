{
  "uid": "llm-cost-usage",
  "title": "LLM cost and usage",
  "tags": ["platform", "analytics", "llm", "cost"],
  "description": "What the LLM calls cost, per workspace, agent and model, and the token volume that backs it. The cost is computed live in the analytics.llm_usage view from the current prices, so a price change re-prices the history. This dashboard lives in a folder gated to a dedicated Grafana team: the per-workspace cost is commercially sensitive.",
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "organization",
        "label": "Organization",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "analytics"
        },
        "definition": "SELECT DISTINCT organization_name AS __text, organization_id AS __value FROM analytics.llm_usage ORDER BY 1",
        "query": "SELECT DISTINCT organization_name AS __text, organization_id AS __value FROM analytics.llm_usage ORDER BY 1",
        "sort": 1
      },
      {
        "name": "project",
        "label": "Workspace",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "analytics"
        },
        "definition": "SELECT project_name AS __text, project_id AS __value FROM analytics.llm_usage WHERE organization_id IN (${organization:sqlstring}) ORDER BY 1",
        "query": "SELECT project_name AS __text, project_id AS __value FROM analytics.llm_usage WHERE organization_id IN (${organization:sqlstring}) ORDER BY 1",
        "sort": 1
      }
    ]
  },
