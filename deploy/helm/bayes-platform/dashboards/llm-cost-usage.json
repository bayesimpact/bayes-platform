          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(sum(cost), 0) FROM analytics.llm_usage WHERE created_at > now() - interval '7 days' AND organization_id IN (${organization:sqlstring}) AND project_id IN (${project:sqlstring})"
