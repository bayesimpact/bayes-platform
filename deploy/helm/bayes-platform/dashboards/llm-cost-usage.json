          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), 'input' AS metric, sum(input_tokens) AS value FROM analytics.llm_usage WHERE $__timeFilter(created_at) AND organization_id IN (${organization:sqlstring}) AND project_id IN (${project:sqlstring}) GROUP BY 1\nUNION ALL\nSELECT $__timeGroupAlias(created_at, '1d'), 'output', sum(output_tokens) FROM analytics.llm_usage WHERE $__timeFilter(created_at) AND organization_id IN (${organization:sqlstring}) AND project_id IN (${project:sqlstring}) GROUP BY 1\nUNION ALL\nSELECT $__timeGroupAlias(created_at, '1d'), 'cache_read', sum(cache_read_tokens) FROM analytics.llm_usage WHERE $__timeFilter(created_at) AND organization_id IN (${organization:sqlstring}) AND project_id IN (${project:sqlstring}) GROUP BY 1\nUNION ALL\nSELECT $__timeGroupAlias(created_at, '1d'), 'cache_write', sum(cache_write_tokens) FROM analytics.llm_usage WHERE $__timeFilter(created_at) AND organization_id IN (${organization:sqlstring}) AND project_id IN (${project:sqlstring}) GROUP BY 1\nUNION ALL\nSELECT $__timeGroupAlias(created_at, '1d'), 'reasoning', sum(reasoning_tokens) FROM analytics.llm_usage WHERE $__timeFilter(created_at) AND organization_id IN (${organization:sqlstring}) AND project_id IN (${project:sqlstring}) GROUP BY 1\nORDER BY 1"
        }
