          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT p.organization_name AS organization,\n p.name AS workspace,\n count(m.*) FILTER (WHERE m.created_at > now() - interval '24 hours') AS \"messages 24h\",\n max(m.completed_at) FILTER (WHERE m.role = 'assistant' AND m.status = 'completed') AS \"last answer\",\n round(100.0 * count(*) FILTER (WHERE m.status = 'error' AND m.created_at > now() - interval '24 hours')\n   / NULLIF(count(*) FILTER (WHERE m.role = 'assistant' AND m.created_at > now() - interval '24 hours'), 0), 1) AS \"error % 24h\",\n round((percentile_cont(0.95) WITHIN GROUP (ORDER BY m.response_seconds) FILTER (WHERE m.role = 'assistant' AND m.status = 'completed' AND m.created_at > now() - interval '24 hours'))::numeric, 1) AS \"p95 s 24h\",\n count(*) FILTER (WHERE m.status = 'streaming' AND m.created_at BETWEEN now() - interval '24 hours' AND now() - interval '10 minutes') AS stuck\n FROM analytics.projects p\n LEFT JOIN analytics.messages m ON m.project_id = p.project_id AND m.channel IN (${channel:sqlstring})\n WHERE p.project_id IN (${project:sqlstring})\n GROUP BY 1, 2\n ORDER BY \"last answer\" NULLS FIRST, 1, 2"
        }
